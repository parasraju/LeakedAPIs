# API Instructor — environment reference
# Reference only: API Instructor reads variables from the OS environment.
# It does not load this file. Set the variables you need, e.g. via:
#   PowerShell:  $env:GROQ_API_KEY="gsk_..."
# or set them as secrets in your CI/terminal profile before running
#   python main.py validate groq
# Never commit a real .env (it is gitignored).
#
# Full docs: docs/PROVIDERS.md

# ---- Model providers ----
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=             # or GEMINI_API_KEY
XAI_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
COHERE_API_KEY=
GROQ_API_KEY=
TOGETHER_API_KEY=
OPENROUTER_API_KEY=
FIREWORKS_API_KEY=
PERPLEXITY_API_KEY=
CEREBRAS_API_KEY=
SAMBANOVA_API_KEY=
DEEPINFRA_API_KEY=
AI21_API_KEY=
REPLICATE_API_TOKEN=
HF_TOKEN=                   # or HUGGINGFACE_TOKEN

# ---- Special-auth providers (no single API key) ----
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AWS_ACCESS_KEY_ID=          # Bedrock (SigV4)
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
GOOGLE_APPLICATION_CREDENTIALS=    # Vertex AI service account JSON
GOOGLE_CLOUD_PROJECT=

# ---- Scanner (unchanged) ----
GITHUB_TOKEN=